VITE_API_URL=http://localhost:5000
# Optional: if set, this must match server/GOOGLE_CLIENT_ID.
# Add the active Vite origin (for example, http://localhost:5174) to the
# OAuth Web client’s Authorized JavaScript origins in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# Public footer contact and social links (optional; use official HTTPS URLs only)
VITE_PUBLIC_SUPPORT_EMAIL=
VITE_PUBLIC_SOCIAL_INSTAGRAM=
VITE_PUBLIC_SOCIAL_LINKEDIN=
VITE_PUBLIC_SOCIAL_YOUTUBE=
VITE_PUBLIC_SOCIAL_X=
