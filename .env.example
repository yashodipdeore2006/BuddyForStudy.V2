VITE_API_URL=http://localhost:5000
# Public HTTPS production site origin used for canonical URLs on public marketing/legal routes. Set the verified domain in the hosting build environment.
VITE_PUBLIC_SITE_URL=
# Public Build with AI v2 rollout flags. Keep both off until the server-side flags are enabled and validated.
# Coordinate these values with INTENT_V2 and ASYNC_ROADMAP on the backend.
VITE_INTENT_V2=false
VITE_ASYNC_ROADMAP=false

# Optional: if set, this must match server/GOOGLE_CLIENT_ID.
# Add the active Vite origin (for example, http://localhost:5174) to the
# OAuth Web client’s Authorized JavaScript origins in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=

# Public footer contact and social links (optional; use official HTTPS URLs only)
VITE_PUBLIC_SUPPORT_EMAIL=
VITE_PUBLIC_SOCIAL_INSTAGRAM=
VITE_PUBLIC_SOCIAL_LINKEDIN=
VITE_PUBLIC_SOCIAL_YOUTUBE=
VITE_PUBLIC_SOCIAL_X=
