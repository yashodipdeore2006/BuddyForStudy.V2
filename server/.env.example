NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/buddyforstudy
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Google Identity Services
# Use the same Web client ID in the frontend and backend.
GOOGLE_CLIENT_ID=

# Learning content
# Gemini is used only for on-demand module quiz generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
YOUTUBE_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Redis (optional)
REDIS_URL=redis://127.0.0.1:6379

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Admin email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional push delivery through OneSignal (keep REST key server-side only)
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Initial admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=BuddyForStudy Admin
