NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/buddyforstudy
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Google Identity Services
# Use the same Web client ID in the frontend and backend.
GOOGLE_CLIENT_ID=

# Learning content
# Gemini is used only for on-demand module quiz generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
YOUTUBE_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Redis (optional)
REDIS_URL=redis://127.0.0.1:6379

# Sentry (optional)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Admin email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Direct browser Web Push delivery (generate with: npm run generate:web-push-keys)
# Keep the private key server-side and never commit real keys.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@example.com

# Initial admin bootstrap
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=BuddyForStudy Admin
# Optional admin profile for the bootstrap script. Set to super_admin only for the initial platform owner.
ADMIN_ROLE=
